# =====================================================================
# Slide Studio — muhit o'zgaruvchilari shabloni.
# Lokal: shu faylni ".env" nomi bilan nusxalang va to'ldiring.
# Render/Railway: shu nomlarni Environment bo'limiga kiriting.
# .env faylini GitHub'ga YUKLAMANG (.gitignore da bor).
# Izohlar alohida qatorda; qiymat "=" dan keyin yoziladi.
# =====================================================================

# ===== MAJBURIY =====

# AI provayder kaliti (OpenAI-mos API; standart: DeepSeek) — https://platform.deepseek.com
AI_API_KEY=
# Provayder manzili (ixtiyoriy)
AI_BASE_URL=https://api.deepseek.com

# Supabase: Project Settings -> API
SUPABASE_URL=
# "Publishable" (anon) kalit — brauzerga beriladi
SUPABASE_PUBLISHABLE_KEY=
# "Secret" (service_role) kalit — FAQAT serverda, hech kimga ko'rsatmang!
SUPABASE_SECRET_KEY=
# (ixtiyoriy) Eski "Legacy JWT secret" (Project Settings -> API -> JWT). Faqat loyiha HS256 tokenlardan
# foydalansa kerak. Yangi "JWT signing keys" (ES256/RS256) bo'lsa BO'SH qoldiring — kalitlar avtomatik olinadi.
SUPABASE_JWT_SECRET=

# Google OAuth Client ID (Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=

# Uzun tasodifiy qator. Hosil qilish:  openssl rand -hex 32
SLIDE_STUDIO_HMAC_SECRET=

# Saytingiz to'liq manzili (https bilan, oxirida "/" siz)
PUBLIC_BASE_URL=https://sizning-domeningiz.onrender.com

# ===== TELEGRAM BOT (ixtiyoriy) =====
# BotFather'dan token. Bo'sh = bot o'chiq (sayt odatdagidek ishlaydi).
TELEGRAM_BOT_TOKEN=
# Webhook maxfiy kaliti (bo'sh = tokendan avtomatik hosil bo'ladi)
TELEGRAM_WEBHOOK_SECRET=
# auto | webhook | polling
TELEGRAM_MODE=auto
# Bot updates are handled by ONE gunicorn worker (chat state is in RAM); others forward to it. 0 = off
TG_ONE_WORKER=1
# RAM budget (MB) for downloaded slide images kept for the next bot export, shared by all chats
TG_IMG_RAM_MB=96
# v78: slayd tayyor bo'lgach bot avtomatik yuboradigan fayl: pptx (standart) | pdf | both | off
TG_AUTO_SEND=pptx
# v78: Telegram akkauntining kunlik bepul varag'i (bo'sh = saytdagi bilan bir xil; 0 = Telegram'ga bepul varaq yo'q)
TG_FREE_DAILY_PAGES=

# ===== XAVFSIZLIK =====
# Bo'sh = faqat o'z domeni. Kerak bo'lsa: https://a.com,https://b.com
ALLOWED_ORIGINS=
# Productionda BO'SH qoldiring!
SLIDE_STUDIO_DEV_MODE=
# Rate limit uchun mijoz IP: X-Forwarded-For dagi o'ngdan nechta proksi (Render = 1)
TRUSTED_PROXY_HOPS=1
# Sayt Cloudflare ortida bo'lsa 1 qiling (CF-Connecting-IP ga ishoniladi). Aks holda BO'SH qoldiring!
TRUST_CF_CONNECTING_IP=

# ===== ADMIN PANEL =====
# Admin = Telegram ID VA unga ulangan Google email — IKKALASI ham mos kelishi shart.
# Telegram ID ni bilish: botga /id deb yozing. Bir nechta bo'lsa vergul bilan.
ADMIN_TG_IDS=
ADMIN_EMAILS=

# ===== TO'LOV: Dodo Payments (Merchant of Record) =====
# test -> https://test.dodopayments.com, live -> https://live.dodopayments.com
DODO_PAYMENTS_ENV=test
DODO_PAYMENTS_API_KEY=
# "Pay What You Want" mahsuloti (minimal narx $1)
DODO_PRODUCT_ID=
# Dashboard -> Webhooks: https://<manzil>/webhooks, signing secret (whsec_...)
DODO_WEBHOOK_SECRET=
# Komissiya mijoz narxiga qo'shiladi: gross = ceil((N + FIXED) / (1 - PERCENT/100))
# 5.5% = 4% bazaviy + 1.5% xalqaro karta; $0.40 fiks. $1 -> $1.49, $5 -> $5.71
DODO_FEE_PERCENT=5.5
DODO_FEE_FIXED_CENTS=40

# ===== LIMITLAR / NARX =====
# Bepul: kuniga 10 Tez-varaq (= 5 Chuqur-varaq)
FREE_DAILY_PAGES=10
# Pullik paket: 100 Tez-varaq (= 50 Chuqur-varaq)
PAGES_PER_PACK=100
# Bot matnlarida ko'rinadigan narx: 100 varaq = $1.00 netto + Dodo komissiyasi = $1.49
PACK_PRICE_USD=1.49
# Server RAM keshi (MB, diskka yozilmaydi)
IMG_PROXY_CACHE_MB=32
# Proksi orqali bir vaqtda yuklanadigan rasm / video soni (RAM himoyasi)
PROXY_IMAGE_CONCURRENCY=6
PROXY_VIDEO_CONCURRENCY=1

# ===== RASM / GIF QIDIRUV KALITLARI (ixtiyoriy) =====
KLIPY_API_KEY=
GIPHY_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ===== KATTA YUK (ixtiyoriy) =====
LOG_LEVEL=warning
# REDIS_URL=
# MAX_WS=2000

# ===== v52: yuklama va himoya sozlamalari (hammasi ixtiyoriy) =====
# DeepSeek'ga bir vaqtda ketadigan so'rovlar (qolganlari navbatda kutadi)
DEEPSEEK_CONCURRENCY=40
# Navbatda maksimal kutish (soniya); oshsa "server band" deyiladi va varaq yechilmaydi
DS_QUEUE_TIMEOUT=90
# Bitta foydalanuvchi uchun 1 daqiqadagi limit: yangi deck rejasi / slayd-slayd yaratish / oddiy chat
WS_RPM_PLAN=5
WS_RPM_GENERATE=40
WS_RPM_CHAT=15
# Telegram botda bir vaqtda AI so'rovlari
TG_AI_PARALLEL=24
# Botda bir vaqtda nechta fayl (PPTX/PDF) tayyorlanadi — RAM ko'p ishlatadi, shuning uchun kam (512 MB server: 3)
# v80: bo'sh qoldiring — server RAM/CPU'siga qarab o'zi tanlanadi (512 MB -> 1; 4 GB/4 CPU -> 8)
TG_EXPORT_PARALLEL=
# v80: PPTX/PDF yasash uchun alohida jarayonlar (bo'sh = avto: 2+ CPU va RAM yetsa; 0 = o'chiq)
TG_EXPORT_PROCS=
# v80: Telegram API'ga soniyasiga so'rovlar (Telegram limiti ~30/s butun bot uchun)
TG_API_RPS=25
# Navbatda kutayotgan AI so'rovlari chegarasi. Undan ko'p bo'lsa — «hozir band» deyiladi (kutish deyarli RAM yemaydi)
TG_QUEUE_MAX=400
# Botda bir vaqtda xotirada turadigan chatlar soni (har biri ~10–20 KB). Katta auditoriya uchun oshiring
TG_MAX_CHATS=3000
# Worker (jarayon) soni serverning RAM va CPU limitiga qarab AVTOMATIK tanlanadi (backend/gunicorn_conf.py):
#   512 MB -> 2, 2 GB / 1 CPU -> 2, 4 GB / 2 CPU -> 4 (eng ko'pi 8). Aniq son kerak bo'lsa: WEB_CONCURRENCY=3
# WEB_CONCURRENCY=
# Bitta worker uchun RAM byudjeti (MB) — avtomatik hisob shunga qarab bo'ladi
# WORKER_RAM_MB=170
# Xotiradagi sayt sessiyalari soni chegarasi (har biri ~1 KB)
MAX_SESSIONS_RAM=20000
# asyncio thread hovuzi (Supabase so'rovlari uchun)
THREAD_POOL_SIZE=32
# Render free reja uxlab qolmasligi uchun
KEEPALIVE=1

# ===== Audit: barqarorlik sozlamalari (hammasi ixtiyoriy) =====
# Bitta "katta" so'rovda balansdan oshib ketishi mumkin bo'lgan maksimal qarz (Tez-varaq)
MAX_DEBT_PAGES=10
# Bitta foydalanuvchining bir vaqtdagi AI so'rovlari (har bir worker ichida)
MAX_AI_INFLIGHT_PER_USER=1
# WebSocket xabarining maksimal hajmi (bayt)
WS_MAX_SIZE=4194304
# /api/user/usage keshi (soniya)
USAGE_CACHE_TTL=15
# AI: ikki bo'lak orasidagi maksimal jimlik / bitta javobning umumiy vaqti (soniya)
AI_READ_TIMEOUT=120
AI_TURN_DEADLINE_FAST=300
AI_TURN_DEADLINE_DEEP=600
# JWT ni lokal tekshirish (1 = yoqilgan) va Supabase Auth'dan sessiyani qayta tekshirish oralig'i (soniya)
JWT_LOCAL_VERIFY=1
AUTH_REVALIDATE_SEC=600
# Ulanish uzilsa AI javobi fonda necha soniya davom etadi (qayta ulanganda tiklash uchun). 0 = darhol to'xtatish
RESUME_DETACH_SEC=120
# Bir IP'dan 24 soatda nechta yangi akkaunt bepul varaq oladi (0 = cheklov o'chiq)
MAX_FREE_SIGNUPS_PER_IP_DAY=3
# Eski yozuvlarni saqlash muddati (kun). To'lovlar (payment_events) hech qachon o'chirilmaydi
RETENTION_LEDGER_DAYS=365
RETENTION_AUDIT_DAYS=365
RETENTION_ADSENT_DAYS=7
# v82: Supabase limit himoyasi. Baza shu hajmdan (MB) oshsa — favqulodda tozalash + adminga Telegram xabar.
# Bepul reja 500 MB -> 400. Pullik rejada (8 GB) masalan 7000 qiling
DB_SOFT_LIMIT_MB=400
# Bot taqdimoti shuncha kun ochilmasa o'chiriladi (eng kami 7)
RETENTION_TG_DECKS_DAYS=180

# ===== Kuzatuv (monitoring) =====
# json = har bir log qatori JSON (vaqt, daraja, request_id)
LOG_FORMAT=
# /metrics uchun maxfiy token (bo'sh = /metrics o'chiq). Hosil qilish: openssl rand -hex 24
METRICS_TOKEN=
# Sentry (ixtiyoriy): xatolarni yig'ish
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
