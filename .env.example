# =====================================================================
# Slide Studio — muhit o'zgaruvchilari shabloni.
# Lokal: shu faylni ".env" nomi bilan nusxalang va to'ldiring.
# Render/Railway: shu nomlarni Environment bo'limiga kiriting.
# .env faylini GitHub'ga YUKLAMANG (.gitignore da bor).
# Izohlar alohida qatorda; qiymat "=" dan keyin yoziladi.
# =====================================================================

# ===== MAJBURIY =====

# AI provayder kaliti (OpenAI-mos API; standart: DeepSeek) — https://platform.deepseek.com
AI_API_KEY=
# Provayder manzili (ixtiyoriy)
AI_BASE_URL=https://api.deepseek.com

# Supabase: Project Settings -> API
SUPABASE_URL=
# "Publishable" (anon) kalit — brauzerga beriladi
SUPABASE_PUBLISHABLE_KEY=
# "Secret" (service_role) kalit — FAQAT serverda, hech kimga ko'rsatmang!
SUPABASE_SECRET_KEY=

# Google OAuth Client ID (Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=

# Uzun tasodifiy qator. Hosil qilish:  openssl rand -hex 32
SLIDE_STUDIO_HMAC_SECRET=

# Saytingiz to'liq manzili (https bilan, oxirida "/" siz)
PUBLIC_BASE_URL=https://sizning-domeningiz.onrender.com

# ===== TELEGRAM BOT (ixtiyoriy) =====
# BotFather'dan token. Bo'sh = bot o'chiq (sayt odatdagidek ishlaydi).
TELEGRAM_BOT_TOKEN=
# Webhook maxfiy kaliti (bo'sh = tokendan avtomatik hosil bo'ladi)
TELEGRAM_WEBHOOK_SECRET=
# auto | webhook | polling
TELEGRAM_MODE=auto

# ===== XAVFSIZLIK =====
# Bo'sh = faqat o'z domeni. Kerak bo'lsa: https://a.com,https://b.com
ALLOWED_ORIGINS=
# Productionda BO'SH qoldiring!
SLIDE_STUDIO_DEV_MODE=
# Rate limit uchun mijoz IP: X-Forwarded-For dagi o'ngdan nechta proksi (Render = 1)
TRUSTED_PROXY_HOPS=1
# Sayt Cloudflare ortida bo'lsa 1 qiling (CF-Connecting-IP ga ishoniladi). Aks holda BO'SH qoldiring!
TRUST_CF_CONNECTING_IP=

# ===== ADMIN PANEL =====
# Admin = Telegram ID VA unga ulangan Google email — IKKALASI ham mos kelishi shart.
# Telegram ID ni bilish: botga /id deb yozing. Bir nechta bo'lsa vergul bilan.
ADMIN_TG_IDS=
ADMIN_EMAILS=

# ===== TO'LOV: Lemon Squeezy (ixtiyoriy) =====
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
# Varaq PAKETI mahsuloti (bir martalik)
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ===== LIMITLAR / NARX =====
# Bepul: kuniga 10 Tez-varaq (= 5 Chuqur-varaq)
FREE_DAILY_PAGES=10
# Pullik paket: 100 Tez-varaq (= 50 Chuqur-varaq)
PAGES_PER_PACK=100
# Bot matnlarida ko'rinadigan narx: $1.00 netto + Lemon komissiyasi (6.5% + $0.50) = $1.61
PACK_PRICE_USD=1.61
# Server RAM keshi (MB, diskka yozilmaydi)
IMG_PROXY_CACHE_MB=32
# Proksi orqali bir vaqtda yuklanadigan rasm / video soni (RAM himoyasi)
PROXY_IMAGE_CONCURRENCY=6
PROXY_VIDEO_CONCURRENCY=1

# ===== RASM / GIF QIDIRUV KALITLARI (ixtiyoriy) =====
KLIPY_API_KEY=
GIPHY_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ===== KATTA YUK (ixtiyoriy) =====
LOG_LEVEL=warning
# REDIS_URL=
# MAX_WS=2000

# ===== v52: yuklama va himoya sozlamalari (hammasi ixtiyoriy) =====
# DeepSeek'ga bir vaqtda ketadigan so'rovlar (qolganlari navbatda kutadi)
DEEPSEEK_CONCURRENCY=40
# Navbatda maksimal kutish (soniya); oshsa "server band" deyiladi va varaq yechilmaydi
DS_QUEUE_TIMEOUT=90
# Bitta foydalanuvchi uchun 1 daqiqadagi limit: yangi deck rejasi / slayd-slayd yaratish / oddiy chat
WS_RPM_PLAN=5
WS_RPM_GENERATE=40
WS_RPM_CHAT=15
# Telegram botda bir vaqtda AI so'rovlari
TG_AI_PARALLEL=6
# asyncio thread hovuzi (Supabase so'rovlari uchun)
THREAD_POOL_SIZE=32
# Render free reja uxlab qolmasligi uchun
KEEPALIVE=1
